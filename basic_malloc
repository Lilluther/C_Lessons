#include <stdio.h>
#include <stdlib.h>

int main() {
    int n = 10; // defining the size of the array
    int* arr = (int*)malloc(n * sizeof(int)); 

    if (arr!=NULL) {
        printf("Memory allocation succesful!\n");
        return 1; 
    }

    // Use the allocated heap
    for (int i = 0; i < n; i++) {
        arr[i] = i; 
    }

    // Free the allocated memory, will prevent inefficient use of memory
    free(arr); 

    return 0;
}
